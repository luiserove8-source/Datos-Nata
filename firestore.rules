rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.isAdmin == true;
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Usuarios: solo admins gestionan, todos leen su propio perfil
    match /usuarios/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Actas: todos autenticados pueden leer, crear; nadie puede editar/eliminar (bloqueadas)
    match /actas/{actaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Contador de actas: solo transacciones de servidor (no directamente)
    match /contadores/{doc} {
      allow read, write: if isAuthenticated();
    }

    // Auditoría: solo admins leen, todos escriben (inserción de logs)
    match /auditoria/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
